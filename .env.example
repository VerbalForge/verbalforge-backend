# Database Configuration
MONGO_URI=mongodb://localhost:27017/verbalforge

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Configuration
# Single frontend URL (for backward compatibility)
FRONTEND_URL=http://localhost:3000

# Multiple frontend URLs (comma-separated) - recommended for production
# This allows multiple origins for CORS (e.g., development, staging, production)
# FRONTEND_URLS=http://localhost:3000,https://verbalforge.com,https://www.verbalforge.com

# File Upload Configuration
UPLOAD_DIR=./uploads

# Server Configuration
PORT=8080